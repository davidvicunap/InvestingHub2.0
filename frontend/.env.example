# Production wiring (GitHub Pages build). In local dev these stay empty and the
# Vite proxy forwards /api and /ws to Flask on :8050.

# REST base, e.g. https://investorhub.onrender.com  (no trailing slash)
VITE_API_BASE=

# WebSocket URL, e.g. wss://investorhub.onrender.com/ws
VITE_WS_URL=

# GitHub Pages base path for the build, e.g. /InvestingHub2.0/
# Set on the build command: VITE_BASE=/InvestingHub2.0/ npm run build
